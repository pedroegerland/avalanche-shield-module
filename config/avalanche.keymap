#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        tdlayer: tdlayer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "tdlayer";
            bindings = <&mo>, <&kp>;

            tapping-term-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
        &none  &none  &none  &none  &none  &none                                   &none  &none  &none  &none  &none  &none 
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        &none  &none  &none  &none  &none  &none                                   &none  &none  &none  &none  &none  &none 
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
&none  &none  &none  &none  &none  &none  &none                                   &none  &none  &none  &none  &none  &none  &none 
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
        &none  &none  &none  &none  &none  &none  &none  &none    &none &none  &none  &none  &none  &none  &none  &none 
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
                                &none  &none  &none  &none  &none    &none &none  &none  &none  &none
*/

        default_layer {
            bindings = <
&kp ESC           &kp N1        &kp N2   &kp N3            &kp N4   &kp N5                                             &kp N6         &kp N7                 &kp N8    &kp N9     &kp N0                &kp DELETE
&kp GRAVE         &kp Q         &kp W    &kp E             &kp R    &kp T                                              &kp Y          &kp U                  &kp I     &kp O      &kp P                 &kp MINUS
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp A    &kp S             &kp D    &kp F      &kp G                                                  &kp H                  &kp J     &kp K      &kp L                 &kp SEMI    &kp SQT   &kp HOME
&kp LSHIFT        &kp Z         &kp X    &kp C             &kp V    &kp B      &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RBKT       &kp RIGHT_PARENTHESIS  &kp N     &kp M      &kp COMMA             &kp DOT     &kp FSLH  &kp CAPS
                  &kp C_MUTE    &kp END  &kp LEFT_CONTROL  &kp TAB  &kp SPACE                                          &kp BACKSPACE  &kp RET                &kp BSLH  &kp EQUAL  &kp LS(LG(NUMBER_4))
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
